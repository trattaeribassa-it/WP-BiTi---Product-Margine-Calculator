# WordPress / Plugin repo .gitignore
# (Works whether this repo is "plugin-only" or you keep a full WP install alongside.)

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.code-workspace

# Logs / temp
*.log
*.tmp
*.bak
*.cache
.phpunit.result.cache

# Dependency folders (keep out of git unless you intentionally vendor them)
node_modules/
vendor/

# Build artifacts
dist/
build/
*.map

# Secrets / env
.env
.env.*
wp-config.php

# If you ever store a full WordPress install in this repo, ignore core + runtime folders
/wp-admin/
/wp-includes/
/wp-content/cache/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/backup*/
